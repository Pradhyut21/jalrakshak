# Optional shell environment configuration. No credentials belong in this file.
JAL_STORAGE=sqlite
JAL_COOKIE_SECURE=false
JAL_SESSION_TTL_HOURS=24
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
# Cloud mode uses JAL_STORAGE=dynamodb and JAL_TABLE_NAME from SAM outputs.
# Frontend cross-origin hosting uses VITE_API_BASE_URL at build time.
